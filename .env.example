# Required. Postgres connection string — this is the app's actual persistence
# (users/sessions, audit/GEO/gap history, monitoring, clients, content drafts, usage
# counters). See lib/db.ts. A hosting platform's managed Postgres add-on (Render,
# Railway, Neon, ...) injects this automatically when the DB is linked to the web
# service; for local dev, point it at any local Postgres instance, e.g.:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epicsem_dev"

# GEO/AEO engine — AI provider keys (optional; leave blank to run in DEMO_MODE)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Meta AI and Microsoft Copilot have no public chat-completion API — those two engines
# always run in demo mode (clearly labeled), there is no key to set for them.

# When true (default if no keys set), the GEO engine returns simulated
# but realistic responses instead of calling real LLM APIs.
DEMO_MODE=true

# /content (Content Studio) article generation reuses these same keys — no separate
# key needed. It prefers Anthropic, then OpenAI, then the rest, in that order (see
# lib/content-generator.ts). No key configured -> generates a clearly-labeled demo
# draft instead of calling a real model. WordPress site credentials are NOT set here
# — they're entered per-connection in the /content UI (stored in cms_connections).

# AXO monitoring — default Slack incoming webhook for "newly blocked AI crawler"
# alerts, used when a monitored page doesn't have its own webhook set. Optional —
# alerts are still recorded in-app either way. https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Shared secret that scripts/check-monitors.mjs sends as an x-cron-secret header so
# the /api/monitor/check route lets it sweep every signed-up user's monitored pages
# in one pass (a normal signed-in request only ever touches that user's own pages).
# Required for the cron script to work at all — pick any long random string and set
# the same value here and wherever the script actually runs.
CRON_SECRET=
